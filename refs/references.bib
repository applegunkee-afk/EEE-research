% =====================================================================
% references.bib  --  LaTeX/Overleaf 인용의 단일 원본(source of truth)
% =====================================================================
% 규칙
%  - 검증된 실제 문헌만 추가 (DOI 또는 출판사 페이지로 확인)
%  - 인용 키: firstauthorYEARkeyword  (예: smith2023leosar)  -> refs/README.md 참고
%  - 새 항목은 references.md 표에도 같은 키로 한 줄 추가
%  - 주제별 섹션 아래에 추가 (섹션은 자유롭게 늘려도 됨)
%
% 아래 @comment 블록은 BibTeX가 무시하는 템플릿입니다. 복사 후
% "@comment" -> "@article"(또는 @inproceedings 등)로 바꿔 사용하세요.
% =====================================================================

@comment{TEMPLATE-article,
  author    = {Lastname, Firstname and Lastname, Firstname},
  title     = {Full Title in Title Case},
  journal   = {IEEE Transactions on ...},
  year      = {YYYY},
  volume    = {},
  number    = {},
  pages     = {},
  doi       = {10.xxxx/xxxxx},
  keywords  = {LEO; SAR; surveillance},
}

@comment{TEMPLATE-inproceedings,
  author    = {Lastname, Firstname},
  title     = {Full Title},
  booktitle = {Proc. IEEE ...},
  year      = {YYYY},
  pages     = {},
  doi       = {10.xxxx/xxxxx},
}

